@PACKAGE_INIT@

# Find dependencies
include(CMakeFindDependencyMacro)

find_dependency(Kokkos REQUIRED)
if(KokkosComm_ENABLE_MPI AND NOT TARGET MPI::MPI_CXX)
  find_dependency(MPI REQUIRED)
endif()
if(KokkosComm_ENABLE_NCCL AND NOT TARGET NCCL::NCCL)
  find_dependency(NCCL REQUIRED)
endif()

INCLUDE("${CMAKE_CURRENT_LIST_DIR}/KokkosCommTargets.cmake")
