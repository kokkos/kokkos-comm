set(KokkosComm_VERSION @PROJECT_VERSION@)
set(KokkosComm_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(KokkosComm_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(KokkosComm_VERSION_PATCH @PROJECT_VERSION_PATCH@)
set(KokkosComm_BACKENDS @KOKKOSCOMM_ENABLED_BACKENDS)

@PACKAGE_INIT@

message(STATUS "Kokkos Comm version: ${KokkosComm_VERSION}")
if(NOT KokkosComm_FIND_QUIETLY)
  message(STATUS "Enabled Kokkos Comm backends: ${KokkosComm_BACKENDS}")
endif()

set(KOKKOSCOMM_ENABLE_MPI "@KOKKOSCOMM_ENABLE_MPI@")
set(KOKKOSCOMM_IMPL_MPI_IS_MPICH "@KOKKOSCOMM_IMPL_MPI_IS_MPICH@")
set(KOKKOSCOMM_IMPL_MPI_IS_OPENMPI "@KOKKOSCOMM_IMPL_MPI_IS_OPENMPI@")
set(KOKKOSCOMM_IMPL_MPI_HAS_MPIEXT_H "@KOKKOSCOMM_IMPL_MPI_HAS_MPIEXT_H@")
set(KOKKOSCOMM_ENABLE_NCCL "@KOKKOSCOMM_ENABLE_NCCL@")
set(KOKKOSCOMM_ABORT_ON_ERROR "@KOKKOSCOMM_ABORT_ON_ERROR@")

include(CMakeFindDependencyMacro)

find_dependency(Kokkos)
if(KOKKOSCOMM_ENABLE_MPI AND NOT TARGET MPI::MPI_CXX)
  find_dependency(MPI REQUIRED)
endif()
if(KOKKOSCOMM_ENABLE_NCCL AND NOT TARGET NCCL::NCCL)
  find_dependency(NCCL REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/KokkosCommTargets.cmake")
